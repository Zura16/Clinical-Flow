{
  "name": "pl_metadata_driven_ingestion",
  "properties": {
    "description": "Dynamic metadata-driven ingestion pipeline reading control table pipeline_config and looping across active sources.",
    "activities": [
      {
        "name": "LookupActivePipelineConfig",
        "type": "Lookup",
        "dependsOn": [],
        "policy": { "timeout": "0.00:10:00", "retry": 3 },
        "typeProperties": {
          "source": {
            "type": "AzureSqlSource",
            "sqlReaderQuery": "SELECT source_name, source_table, destination_table, ingestion_type, watermark_column, primary_key_columns FROM dbo.pipeline_config WHERE active_flag = 1"
          },
          "dataset": { "referenceName": "ds_sql_server_source", "type": "DatasetReference" },
          "firstRowOnly": false
        }
      },
      {
        "name": "ForEachSourceTable",
        "type": "ForEach",
        "dependsOn": [ { "activity": "LookupActivePipelineConfig", "dependencyConditions": ["Succeeded"] } ],
        "typeProperties": {
          "items": { "value": "@activity('LookupActivePipelineConfig').output.value", "type": "Expression" },
          "activities": [
            {
              "name": "ExecuteDatabricksBronzeIngestion",
              "type": "DatabricksNotebook",
              "dependsOn": [],
              "typeProperties": {
                "notebookPath": "/ClinicalFlow/databricks/bronze/ingest_raw_data",
                "baseParameters": {
                  "SourceName": { "value": "@item().source_name", "type": "Expression" },
                  "SourceTable": { "value": "@item().source_table", "type": "Expression" },
                  "DestinationTable": { "value": "@item().destination_table", "type": "Expression" },
                  "IngestionType": { "value": "@item().ingestion_type", "type": "Expression" }
                }
              },
              "linkedServiceName": { "referenceName": "ls_azure_databricks", "type": "LinkedServiceReference" }
            }
          ]
        }
      }
    ]
  }
}
